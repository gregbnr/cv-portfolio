---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/motion.css';

interface Props {
  lang: 'fr' | 'en';
  title: string;
  description: string;
  image?: string;
}

const { lang, title, description, image = '/img/og-image.jpg' } = Astro.props;
const base = Astro.site ?? new URL(Astro.url.origin);
const ogImage = new URL(image, base).href;
const canonical = new URL(Astro.url.pathname, base).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {/* Anti-FOUC : applique le thème mémorisé avant le premier paint. */}
    <script is:inline>
      try {
        const v = localStorage.getItem('color-scheme');
        if (v === 'dark' || v === 'light') {
          document.querySelector('meta[name="color-scheme"]').content = v;
        }
      } catch (e) {
        /* localStorage indisponible : on suit le système. */
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* hreflang (passer en URLs absolues via `site` au déploiement). */}
    <link rel="alternate" hreflang="fr" href="/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="x-default" href="/" />
    <link rel="canonical" href={canonical} />

    {/* Open Graph / Twitter */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <slot name="nav" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
