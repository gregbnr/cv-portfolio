---
import type { SiteContent } from '../data/types';
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import AppsShowcase from '../components/AppsShowcase.astro';
import Skills from '../components/Skills.astro';
import GenUI from '../components/GenUI.astro';
import Articles from '../components/Articles.astro';
import Hobbies from '../components/Hobbies.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

interface Props {
  content: SiteContent;
  title: string;
  description: string;
}
const { content, title, description } = Astro.props;
---

<Base lang={content.lang} title={title} description={description}>
  <Nav slot="nav" content={content} />
  <span id="top"></span>
  <Hero content={content} />
  <About content={content} />
  <ExperienceTimeline content={content} />
  <AppsShowcase content={content} />
  <Skills content={content} />
  <GenUI content={content} />
  <Articles content={content} />
  <Hobbies content={content} />
  <Contact content={content} />
  <Footer slot="footer" content={content} />
</Base>
