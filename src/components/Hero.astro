---
import type { SiteContent } from '../data/types';
import HeroCode from './HeroCode.astro';
import { withBase } from '../lib/url';

interface Props {
  content: SiteContent;
}
const { content } = Astro.props;
const h = content.hero;

const [firstName, ...restName] = h.name.split(' ');
const lastName = restName.join(' ');
---

<section
  class="hero"
  aria-labelledby="hero-title"
  data-spotlight
  style="--spot-size: 540px;"
>
  <div class="hero-bg" aria-hidden="true">
    <span class="aurora a1"></span>
    <span class="aurora a2"></span>
    <span class="aurora a3"></span>
    <span class="grid-layer"></span>
  </div>

  <div class="hero-inner container">
    <div class="hero-text">
      <p class="label">{h.label}</p>
      <h1 id="hero-title">{firstName}{' '}<span class="grad">{lastName}</span></h1>
      <p class="tagline">{h.tagline}</p>
      <p class="sub">{h.sub}</p>
      <div class="cta">
        <a class="btn prim" href="#contact">{h.ctaContact}</a>
        <a class="btn ghost" href={withBase(content.cvUrl)} download>{h.ctaCv}</a>
      </div>
      <ul class="meta">
        {h.meta.map((m) => <li>{m.value}</li>)}
      </ul>
    </div>
    <div class="hero-visual">
      <HeroCode />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  /* --- Fond : aurora + grille --- */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: clip;
    pointer-events: none;
  }
  .aurora {
    position: absolute;
    border-radius: 50%;
    filter: blur(64px);
    opacity: 0.55;
    will-change: transform;
  }
  .aurora.a1 {
    width: 62vmax;
    height: 62vmax;
    top: -28%;
    left: -12%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--violet) 85%, transparent),
      transparent 68%
    );
  }
  .aurora.a2 {
    width: 52vmax;
    height: 52vmax;
    bottom: -30%;
    right: -14%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--pink) 80%, transparent),
      transparent 68%
    );
    opacity: 0.5;
  }
  .aurora.a3 {
    width: 34vmax;
    height: 34vmax;
    top: 20%;
    right: 20%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, #22d3ee 55%, transparent),
      transparent 70%
    );
    opacity: 0.28;
  }
  .grid-layer {
    position: absolute;
    inset: -10%;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 38px 38px;
    -webkit-mask-image: radial-gradient(70% 60% at 35% 20%, #000, transparent 78%);
    mask-image: radial-gradient(70% 60% at 35% 20%, #000, transparent 78%);
    opacity: 0.6;
    will-change: transform;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: var(--space-12);
    align-items: center;
  }
  .label {
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent-text);
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    margin-top: var(--space-3);
  }
  .grad {
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tagline {
    font-size: clamp(1.05rem, 2.5vw, 1.4rem);
    margin-top: var(--space-4);
    max-width: 32ch;
    font-weight: 500;
  }
  .sub {
    color: var(--muted);
    margin-top: var(--space-3);
    max-width: 46ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .btn {
    display: inline-grid;
    place-items: center;
    padding: 12px 22px;
    border-radius: var(--radius);
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .btn.prim {
    color: #fff;
    background: var(--grad-accent);
    box-shadow: 0 12px 34px var(--glow);
    transition:
      filter 0.18s ease,
      box-shadow 0.18s ease,
      transform 0.18s ease;
  }
  .btn.prim:hover {
    filter: brightness(1.08);
    box-shadow: 0 16px 44px var(--glow);
  }
  .btn.ghost {
    color: var(--ink);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    border: 1px solid var(--border-strong);
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      transform 0.18s ease;
  }
  .btn.ghost:hover {
    border-color: var(--violet);
    background: color-mix(in srgb, var(--violet) 14%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .btn:hover {
      transform: translateY(-2px);
    }
  }
  .meta {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .meta li {
    position: relative;
    padding-left: 14px;
  }
  .meta li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--violet);
  }
  .hero-visual {
    justify-self: center;
    will-change: transform;
  }

  /* --- Aurora animée (drift) --- */
  @media (prefers-reduced-motion: no-preference) {
    .aurora.a1 {
      animation: drift-1 13s ease-in-out infinite alternate;
    }
    .aurora.a2 {
      animation: drift-2 16s ease-in-out infinite alternate;
    }
    .aurora.a3 {
      animation: drift-3 19s ease-in-out infinite alternate;
    }
    @keyframes drift-1 {
      to {
        transform: translate3d(18%, 14%, 0) scale(1.3);
      }
    }
    @keyframes drift-2 {
      to {
        transform: translate3d(-20%, -12%, 0) scale(1.35);
      }
    }
    @keyframes drift-3 {
      to {
        transform: translate3d(-26%, 22%, 0) scale(0.82);
      }
    }
  }

  /* --- Parallax au scroll (grille + téléphone) --- */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .grid-layer,
      .hero-visual {
        animation: hero-par linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 110vh;
      }
      .grid-layer {
        --par: 120px;
      }
      .hero-visual {
        --par: -80px;
      }
      @keyframes hero-par {
        to {
          transform: translateY(var(--par));
        }
      }
    }
  }

  @media (max-width: 820px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .hero-visual {
      max-width: 400px;
      order: -1;
    }
  }
</style>
