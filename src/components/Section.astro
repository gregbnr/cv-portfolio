---
interface Props {
  id: string;
  heading: string;
  subtitle?: string;
  star?: boolean;
  class?: string;
}
const { id, heading, subtitle, star, class: extra } = Astro.props;
---

<section id={id} class:list={['section', extra]} aria-labelledby={`${id}-h`}>
  <div class="container">
    <header class="section-head" data-reveal>
      <h2 id={`${id}-h`}>
        {star && <span class="star" aria-hidden="true">★</span>}
        {heading}
      </h2>
      {subtitle && <p class="section-sub">{subtitle}</p>}
    </header>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .section-head {
    margin-bottom: var(--space-8);
  }
  h2 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    display: flex;
    align-items: center;
    gap: 0.5ch;
  }
  .star {
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .section-sub {
    color: var(--muted);
    margin-top: var(--space-2);
    max-width: 60ch;
  }
</style>
