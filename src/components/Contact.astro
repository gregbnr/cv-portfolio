---
import type { SiteContent } from '../data/types';
import Section from './Section.astro';

interface Props {
  content: SiteContent;
}
const { content } = Astro.props;
const c = content.contact;
---

<Section id="contact" heading={c.heading} subtitle={c.subtitle}>
  <div class="contact" data-reveal>
    <form id="contact-form" class="form" data-email={c.email} novalidate>
      <label class="field">
        <span>{c.subjectLabel}</span>
        <input type="text" name="subject" required autocomplete="off" />
      </label>
      <label class="field">
        <span>{c.messageLabel}</span>
        <textarea name="message" rows="5" required></textarea>
      </label>
      <button type="submit" class="send">
        {c.sendLabel}
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path fill="currentColor" d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z"></path>
        </svg>
      </button>
    </form>

    <aside class="side">
      <span class="side-label">{c.directLabel}</span>
      <div class="side-actions">
        <button
          type="button"
          id="copy-email"
          class="copy"
          data-email={c.email}
          data-copied={c.copiedLabel}
        >
          {c.copyLabel}
        </button>
        <a
          class="linkedin"
          href={c.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5ZM3 9h4v12H3V9Zm6 0h3.8v1.64h.05c.53-1 1.82-2.05 3.75-2.05C19.4 8.59 21 10.3 21 13.4V21h-4v-6.73c0-1.6-.03-3.66-2.23-3.66-2.23 0-2.57 1.74-2.57 3.54V21H9V9Z"></path>
          </svg>
          {c.linkedinLabel}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </aside>
  </div>
</Section>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: var(--space-8);
    align-items: start;
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .field span {
    font-weight: 600;
    font-size: 0.9rem;
  }
  input,
  textarea {
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    resize: vertical;
  }
  input:user-invalid,
  textarea:user-invalid {
    border-color: #ef4444;
  }
  input:user-valid,
  textarea:user-valid {
    border-color: color-mix(in srgb, var(--violet) 60%, transparent);
  }
  .send {
    align-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    padding: 12px 26px;
    border: none;
    border-radius: var(--radius);
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
    background: var(--grad-accent);
    box-shadow: 0 10px 30px var(--glow);
    cursor: pointer;
    transition:
      filter 0.18s ease,
      box-shadow 0.18s ease,
      transform 0.18s ease;
  }
  .send:hover {
    filter: brightness(1.08);
    box-shadow: 0 14px 38px var(--glow);
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .side-label {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .side-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .copy,
  .linkedin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6ch;
    padding: 12px 18px;
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    color: var(--ink);
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      transform 0.18s ease;
  }
  .copy:hover,
  .linkedin:hover {
    border-color: var(--violet);
    background: color-mix(in srgb, var(--violet) 14%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .send:hover,
    .copy:hover,
    .linkedin:hover {
      transform: translateY(-2px);
    }
  }
  .copy.is-copied {
    border-color: color-mix(in srgb, var(--violet) 60%, transparent);
    color: var(--accent-text);
  }
  @media (max-width: 720px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import '../scripts/contact.ts';
</script>
