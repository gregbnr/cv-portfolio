---
import type { SiteContent } from '../data/types';
import Section from './Section.astro';

interface Props {
  content: SiteContent;
}
const { content } = Astro.props;
const c = content.contact;
---

<Section id="contact" heading={c.heading} subtitle={c.subtitle}>
  <div class="contact" data-reveal>
    <form id="contact-form" class="form" data-email={c.email} novalidate>
      <label class="field">
        <span>{c.subjectLabel}</span>
        <input type="text" name="subject" required autocomplete="off" />
      </label>
      <label class="field">
        <span>{c.messageLabel}</span>
        <textarea name="message" rows="5" required></textarea>
      </label>
      <button type="submit" class="send">{c.sendLabel}</button>
    </form>

    <aside class="side">
      <button
        type="button"
        id="copy-email"
        class="copy"
        data-email={c.email}
        data-copied={c.copiedLabel}
      >
        {c.copyLabel}
      </button>
      <a
        class="linkedin"
        href={c.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            fill="currentColor"
            d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5ZM3 9h4v12H3V9Zm6 0h3.8v1.64h.05c.53-1 1.82-2.05 3.75-2.05C19.4 8.59 21 10.3 21 13.4V21h-4v-6.73c0-1.6-.03-3.66-2.23-3.66-2.23 0-2.57 1.74-2.57 3.54V21H9V9Z"></path>
        </svg>
        {c.linkedinLabel}
      </a>
      <p class="hint">{c.email}</p>
    </aside>
  </div>
</Section>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: var(--space-8);
    align-items: start;
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .field span {
    font-weight: 600;
    font-size: 0.9rem;
  }
  input,
  textarea {
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    resize: vertical;
  }
  input:user-invalid,
  textarea:user-invalid {
    border-color: #ef4444;
  }
  input:user-valid,
  textarea:user-valid {
    border-color: color-mix(in srgb, var(--violet) 60%, transparent);
  }
  .send {
    align-self: start;
    padding: 12px 26px;
    border: none;
    border-radius: var(--radius);
    font-weight: 700;
    color: #fff;
    background: var(--grad-accent);
    box-shadow: 0 10px 30px var(--glow);
    cursor: pointer;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .copy,
  .linkedin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6ch;
    padding: 12px 18px;
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    font: inherit;
  }
  .copy.is-copied {
    border-color: color-mix(in srgb, var(--violet) 60%, transparent);
    color: var(--accent-text);
  }
  .hint {
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
    word-break: break-all;
  }
  @media (max-width: 720px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import '../scripts/contact.ts';
</script>
