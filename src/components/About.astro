---
import type { SiteContent } from '../data/types';
import Section from './Section.astro';
import { withBase } from '../lib/url';

interface Props {
  content: SiteContent;
}
const { content } = Astro.props;
const a = content.about;
const photo: string | undefined = withBase('img/profile-image.webp');
---

<Section id="about" heading={a.heading}>
  <div class="about" data-reveal>
    <div class="photo">
      {
        photo ? (
          <img
            class="photo-img"
            src={photo}
            alt={a.photoAlt}
            width="280"
            height="280"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="photo-ph" role="img" aria-label={a.photoAlt}>
            GB
          </div>
        )
      }
    </div>
    <div class="about-text">
      {a.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
</Section>

<style>
  .about {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-8);
    align-items: center;
  }
  .photo-img {
    width: 100%;
    max-width: 280px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-strong);
    box-shadow: 0 20px 55px var(--glow);
  }
  .photo-ph {
    width: 220px;
    aspect-ratio: 22 / 26;
    border-radius: var(--radius-lg);
    display: grid;
    place-items: center;
    font-size: 3rem;
    font-weight: 800;
    color: #fff;
    background: var(--grad-accent);
    box-shadow: 0 18px 50px var(--glow);
  }
  .about-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: 1.05rem;
  }
  @media (max-width: 680px) {
    .about {
      grid-template-columns: 1fr;
      justify-items: start;
    }
    .photo-img {
      max-width: 180px;
    }
    .photo-ph {
      width: 140px;
    }
  }
</style>
