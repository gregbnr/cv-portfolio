---
interface Props {
  lang: 'fr' | 'en';
  label: string;
}
const { lang, label } = Astro.props;
const href = lang === 'fr' ? '/en/' : '/';
const other = lang === 'fr' ? 'en' : 'fr';
---

<a class="lang-toggle" href={href} hreflang={other} aria-label={label}>
  {lang === 'fr' ? 'EN' : 'FR'}
</a>

<style>
  .lang-toggle {
    display: inline-grid;
    place-items: center;
    min-width: 38px;
    height: 38px;
    padding-inline: 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.8rem;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .lang-toggle:hover {
    border-color: var(--border-strong);
  }
</style>
